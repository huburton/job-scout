# job-scout configuration: every value has a neutral default, nothing is required for `python -m scout demo`.
# Copy to .env (git-ignored) and export it, or pass it to docker compose (--env-file .env).

# Paths
SCOUT_DATA=./data                 # SQLite database
SCOUT_OUT_DIR=./out               # daily digests (Markdown)
SCOUT_PROFILE=./profile.md        # cp profile.example.md profile.md, then edit

# Home town (reference for commute times). The built-in table of known towns only applies to the default home.
#SCOUT_HOME_NAME=Montmédy
#SCOUT_HOME_LAT=49.5207
#SCOUT_HOME_LON=5.3683

# Main LLM: any OpenAI-compatible server (llama.cpp llama-server, vLLM...)
SCOUT_LLM_URL=http://127.0.0.1:8080/v1
SCOUT_LLM_MODEL=local-model
SCOUT_LLM_KEY=                    # or SCOUT_LLM_KEY_FILE=/run/secrets/llm-key

# Optional bigger model on another machine that is not always on (leave empty to disable)
SCOUT_PC_LLM_URL=
SCOUT_PC_STATUS_URL=
SCOUT_PC_KEY=
SCOUT_PC_MODEL=big-model

# Notifications (ntfy). Disabled while the topic is empty.
SCOUT_NTFY_URL=https://ntfy.sh
SCOUT_NTFY_TOPIC=
SCOUT_NTFY_TOKEN=
SCOUT_DASHBOARD_URL=              # optional "open" button in notifications

# Collectors: public JSON APIs by default; HTML-page collectors are opt-in (check each site's terms first)
SCOUT_SOURCES=eures,forem,workday,recruitee,amazon
#SCOUT_SOURCES=eures,forem,workday,recruitee,amazon,ictjob,jobslu,list,lsc

# Sent in the User-Agent of every request, so site owners can reach you
SCOUT_CONTACT=you@example.com

# HTTP API
SCOUT_BIND=127.0.0.1
SCOUT_PORT=8096

# Demo mode: synthetic offers, fake LLM, fake geo table, fully offline
#SCOUT_DEMO=1
